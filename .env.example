# Application
APP_ENV=development
APP_URL=http://localhost:3000
INITIAL_ACCESS_ALLOWLIST=
SETTINGS_ADMIN_TOKEN=

# Prisma Postgres / Neon / PostgreSQL. Use a runtime URL and, for pooled Neon setups, a direct migration URL.
DATABASE_URL=
DIRECT_URL=
PRISMA_DATABASE_URL=
POSTGRES_URL=

# Vercel AI Gateway. In Vercel, VERCEL_OIDC_TOKEN may be supplied automatically.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Central model registry. Use approved provider/model IDs; do not scatter IDs in code.
PLANNING_MODEL=
EXTRACTION_MODEL=
INTERPRETATION_MODEL=
VERIFICATION_MODEL=

# LangSmith tracing (optional locally, recommended in deployed environments).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=monster-scout-sales-hunter
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
